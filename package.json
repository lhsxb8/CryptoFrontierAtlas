{
  "name": "cryptofrontieratlas",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run check:analysis-model",
    "dev": "vite --config vite.config.ts --mode public",
    "dev:public": "vite --config vite.config.ts --mode public",
    "dev:local": "vite --config vite.config.ts --mode internal",
    "build": "tsc -b && vite build --config vite.config.ts --mode public",
    "prebuild:local": "npm run check:analysis-model",
    "build:local": "tsc -b && vite build --config vite.config.ts --mode internal --outDir dist-local",
    "preview": "node scripts/preview.mjs",
    "preview:local": "node scripts/preview.mjs --local",
    "check:data": "node scripts/check-data.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "diagrams:build": "node scripts/build-diagrams.mjs",
    "diagrams:verify": "node scripts/build-diagrams.mjs --verify",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:analyses": "node scripts/atlas.cjs check",
    "export:analyses": "node scripts/published-analyses.mjs export",
    "check:published-data": "node scripts/published-analyses.mjs check",
    "check:publication-fields": "node scripts/published-analyses.mjs check-policy",
    "check:analysis-export": "node scripts/published-analyses.mjs check-export",
    "check:analysis-model": "node scripts/atlas.cjs model",
    "sync:analysis-model": "node scripts/atlas.cjs model --write",
    "check:release": "node scripts/check-public-source.mjs && node scripts/check-public-bundle.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:analyses": "npm run test:corpus",
    "test:ui": "playwright test",
    "atlas": "node scripts/atlas.cjs",
    "index:analyses": "node scripts/atlas.cjs index",
    "check:progress": "node scripts/atlas.cjs progress",
    "report:analyses": "node scripts/atlas.cjs report && node scripts/atlas.cjs progress report --write",
    "report:sota": "node scripts/atlas.cjs sota --write",
    "check:sota": "node scripts/atlas.cjs sota",
    "test": "npm run check:architecture && npm run check:analysis-model && npm run check:publication-fields && npm run test:unit && npm run test:integration",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:corpus": "node scripts/test-corpus.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:types": "tsc -b",
    "check:source": "node scripts/check-public-source.mjs",
    "check:licenses": "node scripts/licenses.mjs --check",
    "licenses:generate": "node scripts/licenses.mjs --write",
    "check:project": "node scripts/check-project.mjs",
    "check:publication": "node scripts/check-project.mjs --ready",
    "check": "npm test && npm run check:types && npm run check:data && npm run check:published-data && npm run check:catalog && npm run check:diagrams && npm run check:version && npm run check:source && npm run check:project && npm run check:licenses",
    "prebuild": "npm run check:licenses"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.3"
  }
}
