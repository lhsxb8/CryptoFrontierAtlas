{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cryptanalysis batch review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "reviewed_on", "source_versions", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "source_versions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "sha256", "locators"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_ids", "result_ids", "decision", "reason"],
        "properties": {
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "decision": {"enum": ["skip_indexed_abstract", "skip_dominated_abstract", "keep_candidate", "needs_details", "audit_required", "skip_out_of_scope"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
