{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cipher-family and round-based instance catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["ciphers", "variants", "coverage_family_ids"],
  "properties": {
    "ciphers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "primitive_type", "aliases", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/text"},
          "primitive_type": {"enum": ["block_cipher", "stream_cipher", "permutation", "hash_function", "aead", "other"]},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
          "description": {"$ref": "#/$defs/text"}
        }
      }
    },
    "variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "family", "full_rounds", "specification_source"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "family": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/text"},
          "key_bits": {"type": "integer", "minimum": 1},
          "block_bits": {"type": "integer", "minimum": 1},
          "full_rounds": {"type": "integer", "minimum": 1},
          "specification_source": {"$ref": "#/$defs/id"},
          "compression": {"$ref": "#/$defs/compression"}
        },
        "if": {"properties": {"compression": {}}, "required": ["compression"]},
        "then": {"properties": {"key_bits": false, "block_bits": false}}
      }
    },
    "coverage_family_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "compression": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "cipher_variant_id", "name", "definition", "output_bits"],
      "properties": {
        "mode": {"enum": ["dm", "mmo", "mp"]}, "cipher_variant_id": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/text"}, "definition": {"$ref": "#/$defs/text"},
        "output_bits": {"type": "integer", "minimum": 1}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
