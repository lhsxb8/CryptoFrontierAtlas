{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public primitive, construction and hard-problem directory (no analysis results)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "categories", "specifications", "primitives", "instances", "problem_sources", "hard_problems"],
  "properties": {
    "schema_version": {"const": 4},
    "standardization": {"$ref": "#/$defs/standardization"},
    "problem_sources": {"type": "array", "items": {"$ref": "#/$defs/problemSource"}},
    "hard_problems": {"type": "array", "items": {"$ref": "#/$defs/hardProblem"}},
    "categories": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "domain", "en", "zh"],
      "properties": {"id": {"$ref": "#/$defs/category"}, "domain": {"enum": ["symmetric", "asymmetric"]}, "en": {"$ref": "#/$defs/text"}, "zh": {"$ref": "#/$defs/text"}},
      "if": {"properties": {"id": {"enum": ["hard_problem", "public_key_encryption", "key_agreement", "digital_signature", "kem"]}}},
      "then": {"properties": {"domain": {"const": "asymmetric"}}},
      "else": {"properties": {"domain": {"const": "symmetric"}}}
    }},
    "specifications": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "edition", "url", "status", "status_note", "checked_on"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "edition": {"$ref": "#/$defs/text"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "status": {"enum": ["published", "withdrawn"]}, "status_note": {"$ref": "#/$defs/text"},
        "checked_on": {"type": "string", "format": "date"}, "withdrawn_on": {"type": "string", "format": "date"},
        "kind": {"enum": ["standard", "rfc", "design_paper", "submission", "designer_specification"]},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
        "citation_observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citationObservation"}}
      },
      "if": {"properties": {"status": {"const": "withdrawn"}}},
      "then": {"properties": {"withdrawn_on": {}}, "required": ["withdrawn_on"]},
      "else": {"properties": {"withdrawn_on": false}}
    }},
    "primitives": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "category", "aliases", "description", "specification_ids", "uses"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "category": {"$ref": "#/$defs/primitiveCategory"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "description": {"$ref": "#/$defs/text"}, "specification_ids": {"$ref": "#/$defs/references"},
        "uses": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "inclusion": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inclusion"}},
        "parameter_scope": {"$ref": "#/$defs/text"}
      }
    }},
    "instances": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family_id", "name", "specification_ids", "locator", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "family_id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"},
        "specification_ids": {"$ref": "#/$defs/references"}, "locator": {"$ref": "#/$defs/text"},
        "note": {"$ref": "#/$defs/text"},
        "parameters": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["type", "key_bits", "block_bits", "rounds"], "properties": {
            "type": {"const": "block_cipher"}, "key_bits": {"$ref": "#/$defs/positive"}, "block_bits": {"$ref": "#/$defs/positive"},
            "rounds": {"$ref": "#/$defs/positive"}, "stages": {"$ref": "#/$defs/positive"}, "key_encoding_bits": {"$ref": "#/$defs/positive"},
            "tweak_bits": {"type": "integer", "minimum": 0}, "tweakey_bits": {"$ref": "#/$defs/positive"},
            "sboxes_per_round": {"$ref": "#/$defs/positive"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["type", "key_bits", "nonce_bits", "counter_bits", "state_bits", "rounds", "keystream_block_bits"], "properties": {
            "type": {"const": "stream_cipher"}, "key_bits": {"$ref": "#/$defs/positive"}, "nonce_bits": {"$ref": "#/$defs/positive"},
            "counter_bits": {"$ref": "#/$defs/positive"}, "state_bits": {"$ref": "#/$defs/positive"},
            "rounds": {"$ref": "#/$defs/positive"}, "keystream_block_bits": {"$ref": "#/$defs/positive"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["type", "output_bits", "state_bits"], "properties": {
            "type": {"const": "hash_function"}, "output_bits": {"$ref": "#/$defs/positive"}, "state_bits": {"$ref": "#/$defs/positive"},
            "block_bits": {"$ref": "#/$defs/positive"}, "compression_steps": {"$ref": "#/$defs/positive"},
            "rate_bits": {"$ref": "#/$defs/positive"}, "capacity_bits": {"$ref": "#/$defs/positive"}, "squeeze_bits": {"$ref": "#/$defs/positive"}
          }, "oneOf": [
            {"properties": {"block_bits": {}, "compression_steps": {}, "rate_bits": false, "capacity_bits": false}, "required": ["block_bits", "compression_steps"]},
            {"properties": {"rate_bits": {}, "capacity_bits": {}, "block_bits": false, "compression_steps": false}, "required": ["rate_bits", "capacity_bits"]}
          ]},
          {"type": "object", "additionalProperties": false, "required": ["type", "output", "state_bits", "rate_bits", "capacity_bits"], "properties": {
            "type": {"const": "xof"}, "output": {"const": "variable"}, "state_bits": {"$ref": "#/$defs/positive"},
            "rate_bits": {"$ref": "#/$defs/positive"}, "capacity_bits": {"$ref": "#/$defs/positive"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["type", "state_bits", "rounds"], "properties": {
            "type": {"const": "permutation"}, "state_bits": {"$ref": "#/$defs/positive"}, "rounds": {"$ref": "#/$defs/positive"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["type", "key_bits", "nonce_bits", "tag_bits"], "properties": {
            "type": {"const": "aead"}, "key_bits": {"$ref": "#/$defs/positive"}, "nonce_bits": {"$ref": "#/$defs/positive"},
            "tag_bits": {"$ref": "#/$defs/positive"}, "state_bits": {"$ref": "#/$defs/positive"}, "rate_bits": {"$ref": "#/$defs/positive"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["type", "key_bits", "block_bits", "tag_bits", "cipher_instance_id"], "properties": {
            "type": {"const": "mac"}, "key_bits": {"$ref": "#/$defs/positive"}, "block_bits": {"$ref": "#/$defs/positive"},
            "tag_bits": {"$ref": "#/$defs/positive"}, "cipher_instance_id": {"$ref": "#/$defs/id"}
          }},
          {"$ref": "#/$defs/feedbackStream"},
          {"$ref": "#/$defs/bytePermutationStream"},
          {"$ref": "#/$defs/compressionHash"},
          {"$ref": "#/$defs/blockCipherCompression"},
          {"$ref": "#/$defs/treeXof"},
          {"$ref": "#/$defs/steppedPermutation"},
          {"$ref": "#/$defs/fieldBlock"},
          {"$ref": "#/$defs/fieldHash"},
          {"$ref": "#/$defs/hmac"},
          {"$ref": "#/$defs/universalMac"},
          {"$ref": "#/$defs/arxMac"},
          {"$ref": "#/$defs/spongeMac"},
          {"$ref": "#/$defs/deterministicAead"},
          {"$ref": "#/$defs/rsaOaep"},
          {"$ref": "#/$defs/rsaPss"},
          {"$ref": "#/$defs/ffdhe"},
          {"$ref": "#/$defs/ecdh"},
          {"$ref": "#/$defs/xdh"},
          {"$ref": "#/$defs/ecdsa"},
          {"$ref": "#/$defs/eddsa"},
          {"$ref": "#/$defs/sm2Encryption"},
          {"$ref": "#/$defs/sm2Signature"},
          {"$ref": "#/$defs/sm2KeyExchange"},
          {"$ref": "#/$defs/mlKem"},
          {"$ref": "#/$defs/mlDsa"},
          {"$ref": "#/$defs/slhDsa"},
              {"$ref":"#/$defs/scmacAead"},
              {"$ref":"#/$defs/namedKemhqc"},
              {"$ref":"#/$defs/namedKemfrodokem"},
              {"$ref":"#/$defs/namedKemclassicmceliece"},
              {"$ref":"#/$defs/namedKemsaber"},
              {"$ref":"#/$defs/namedKemntru"},
              {"$ref":"#/$defs/namedKemntruprime"},
              {"$ref":"#/$defs/namedKembike"},
              {"$ref":"#/$defs/dsa"},
              {"$ref":"#/$defs/rsaPkcs1Signature"},
              {"$ref":"#/$defs/bip340"},
              {"$ref":"#/$defs/falcon"},
              {"$ref":"#/$defs/xmss"},
              {"$ref":"#/$defs/xmssmt"},
              {"$ref":"#/$defs/lms"},
              {"$ref":"#/$defs/hss"}
        ]}
      }
    }}
  },
  "$defs": {
    "standardization": {
      "type": "object", "additionalProperties": false,
      "required": ["checked_on", "reviewed_instance_ids", "standards"],
      "properties": {
        "checked_on": {"type": "string", "format": "date"},
        "reviewed_instance_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "standards": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["specification_id", "designation", "authority", "level", "document_type", "bindings"],
          "properties": {
            "specification_id": {"$ref": "#/$defs/id"}, "designation": {"$ref": "#/$defs/text"},
            "authority": {"$ref": "#/$defs/text"}, "level": {"enum": ["international", "national"]},
            "document_type": {"enum": ["standard", "recommendation"]},
            "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
            "bindings": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["instance_ids", "locator", "role"],
              "properties": {
                "instance_ids": {"$ref": "#/$defs/references"},
                "locator": {"$ref": "#/$defs/text"}, "role": {"enum": ["algorithm", "component"]},
                "note": {"$ref": "#/$defs/text"}
              }
            }}
          },
          "if": {"properties": {"level": {"const": "national"}}},
          "then": {"properties": {"jurisdiction": {}}, "required": ["jurisdiction"]},
          "else": {"properties": {"jurisdiction": false, "document_type": {"const": "standard"}}}
        }}
      }
    },
    "blockCipherCompression": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "mode", "cipher_instance_id", "chaining_bits", "message_bits", "output_bits", "cipher_rounds"],
      "properties": {
        "type": {"const": "hash_function"}, "construction": {"const": "block_cipher_compression"},
        "mode": {"enum": ["dm", "mmo", "mp"]}, "cipher_instance_id": {"$ref": "#/$defs/id"},
        "chaining_bits": {"$ref": "#/$defs/positive"}, "message_bits": {"$ref": "#/$defs/positive"},
        "output_bits": {"$ref": "#/$defs/positive"}, "cipher_rounds": {"$ref": "#/$defs/positive"}
      }
    },
    "https": {"type": "string", "format": "uri", "pattern": "^https://"},
    "citationObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "work_id", "title", "cited_by_count", "checked_on", "url"],
      "properties": {
        "provider": {"enum": ["openalex", "semantic_scholar", "google_scholar"]},
        "work_id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"},
        "cited_by_count": {"type": "integer", "minimum": 0},
        "checked_on": {"type": "string", "format": "date"}, "url": {"$ref": "#/$defs/https"}
      }
    },
    "inclusion": {
      "type": "object", "additionalProperties": false, "required": ["reason", "specification_id", "note"],
      "properties": {
        "reason": {"enum": ["high_citation", "standard", "competition", "historical", "research_design", "recent_design", "maintainer_request"]},
        "specification_id": {"$ref": "#/$defs/id"}, "note": {"$ref": "#/$defs/text"}
      }
    },
    "feedbackStream": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "key_bits", "nonce_bits", "state_bits", "output_bits_per_step"],
      "properties": {
        "type": {"const": "stream_cipher"}, "construction": {"enum": ["feedback", "word_oriented"]},
        "key_bits": {"$ref": "#/$defs/positive"}, "nonce_bits": {"$ref": "#/$defs/positive"},
        "state_bits": {"$ref": "#/$defs/positive"}, "output_bits_per_step": {"$ref": "#/$defs/positive"},
        "initialization_steps": {"$ref": "#/$defs/positive"}
      }
    },
    "bytePermutationStream": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "key_bits", "permutation_entries", "word_bits", "output_bits_per_step"],
      "properties": {
        "type": {"const": "stream_cipher"}, "construction": {"const": "byte_permutation"},
        "key_bits": {"$ref": "#/$defs/positive"}, "permutation_entries": {"const": 256},
        "word_bits": {"const": 8}, "output_bits_per_step": {"const": 8}
      }
    },
    "compressionHash": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "output_bits", "chaining_bits", "block_bits", "compression_rounds"],
      "properties": {
        "type": {"const": "hash_function"}, "construction": {"enum": ["compression", "tree"]},
        "output_bits": {"$ref": "#/$defs/positive"}, "chaining_bits": {"$ref": "#/$defs/positive"},
        "block_bits": {"$ref": "#/$defs/positive"}, "compression_rounds": {"$ref": "#/$defs/positive"},
        "working_state_bits": {"$ref": "#/$defs/positive"}, "chunk_bytes": {"$ref": "#/$defs/positive"}
      },
      "if": {"properties": {"construction": {"const": "tree"}}},
      "then": {"properties": {"chunk_bytes": {}}, "required": ["chunk_bytes"]}, "else": {"properties": {"chunk_bytes": false}}
    },
    "treeXof": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "output", "state_bits", "rate_bits", "capacity_bits", "permutation_rounds", "chunk_bytes"],
      "properties": {
        "type": {"const": "xof"}, "construction": {"const": "tree_sponge"}, "output": {"const": "variable"},
        "state_bits": {"$ref": "#/$defs/positive"}, "rate_bits": {"$ref": "#/$defs/positive"},
        "capacity_bits": {"$ref": "#/$defs/positive"}, "permutation_rounds": {"$ref": "#/$defs/positive"},
        "chunk_bytes": {"$ref": "#/$defs/positive"}
      }
    },
    "fieldModulus": {"type": "string", "pattern": "^[1-9][0-9]{0,154}$"},
    "steppedPermutation": {
      "type": "object", "additionalProperties": false, "required": ["type", "state_bits", "steps"],
      "properties": {"type": {"const": "permutation"}, "state_bits": {"$ref": "#/$defs/positive"}, "steps": {"$ref": "#/$defs/positive"}}
    },
    "fieldBlock": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "field_modulus", "block_elements", "key_elements", "rounds", "sbox_exponent"],
      "properties": {
        "type": {"const": "block_cipher"}, "construction": {"const": "prime_field"}, "field_modulus": {"$ref": "#/$defs/fieldModulus"},
        "block_elements": {"$ref": "#/$defs/positive"}, "key_elements": {"$ref": "#/$defs/positive"},
        "rounds": {"$ref": "#/$defs/positive"}, "sbox_exponent": {"$ref": "#/$defs/positive"}
      }
    },
    "fieldHash": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "construction", "field_modulus", "state_elements", "rate_elements", "capacity_elements", "output_elements", "full_rounds", "partial_rounds", "sbox_exponent"],
      "properties": {
        "type": {"const": "hash_function"}, "construction": {"const": "prime_field_sponge"}, "field_modulus": {"$ref": "#/$defs/fieldModulus"},
        "state_elements": {"$ref": "#/$defs/positive"}, "rate_elements": {"$ref": "#/$defs/positive"},
        "capacity_elements": {"$ref": "#/$defs/positive"}, "output_elements": {"$ref": "#/$defs/positive"},
        "full_rounds": {"$ref": "#/$defs/positive"}, "partial_rounds": {"type": "integer", "minimum": 0}, "sbox_exponent": {"$ref": "#/$defs/positive"}
      }
    },
    "hmac": {
      "type": "object", "additionalProperties": false, "required": ["type", "construction", "key_input", "hash_instance_id", "block_bits", "tag_bits"],
      "properties": {
        "type": {"const": "mac"}, "construction": {"const": "hmac"}, "key_input": {"const": "variable"},
        "hash_instance_id": {"$ref": "#/$defs/id"}, "block_bits": {"$ref": "#/$defs/positive"}, "tag_bits": {"$ref": "#/$defs/positive"}
      }
    },
    "universalMac": {
      "type": "object", "additionalProperties": false, "required": ["type", "construction", "key_bits", "tag_bits", "key_use"],
      "properties": {
        "type": {"const": "mac"}, "construction": {"const": "universal_hash"},
        "key_bits": {"$ref": "#/$defs/positive"}, "tag_bits": {"$ref": "#/$defs/positive"},
        "key_use": {"enum": ["one_time", "nonce_based"]}, "nonce_bits": {"$ref": "#/$defs/positive"}, "block_bits": {"$ref": "#/$defs/positive"}
      },
      "if": {"properties": {"key_use": {"const": "nonce_based"}}},
      "then": {"properties": {"nonce_bits": {}}, "required": ["nonce_bits"]}, "else": {"properties": {"nonce_bits": false}}
    },
    "arxMac": {
      "type": "object", "additionalProperties": false, "required": ["type", "construction", "key_bits", "tag_bits", "block_bits", "compression_rounds", "finalization_rounds"],
      "properties": {
        "type": {"const": "mac"}, "construction": {"const": "arx_prf"}, "key_bits": {"$ref": "#/$defs/positive"},
        "tag_bits": {"$ref": "#/$defs/positive"}, "block_bits": {"$ref": "#/$defs/positive"},
        "compression_rounds": {"$ref": "#/$defs/positive"}, "finalization_rounds": {"$ref": "#/$defs/positive"}
      }
    },
    "spongeMac": {
      "type": "object", "additionalProperties": false, "required": ["type", "construction", "key_input", "tag_bits", "state_bits", "rate_bits", "capacity_bits"],
      "properties": {
        "type": {"const": "mac"}, "construction": {"const": "sponge"}, "key_input": {"const": "variable"},
        "tag_bits": {"$ref": "#/$defs/positive"}, "state_bits": {"$ref": "#/$defs/positive"},
        "rate_bits": {"$ref": "#/$defs/positive"}, "capacity_bits": {"$ref": "#/$defs/positive"}
      }
    },
    "deterministicAead": {
      "type": "object", "additionalProperties": false, "required": ["type", "nonce_mode", "key_bits", "tag_bits"],
      "properties": {
        "type": {"const": "aead"}, "nonce_mode": {"const": "deterministic"},
        "key_bits": {"$ref": "#/$defs/positive"}, "tag_bits": {"$ref": "#/$defs/positive"}
      }
    },
    "problemSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authors",
        "year",
        "edition",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "edition": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "hardProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "aliases",
        "description",
        "statement",
        "parameters",
        "formulations",
        "qualifications",
        "references",
        "related_scheme_ids",
        "related_problem_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "const": "hard_problem"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "parameters": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "modulus",
                "size",
                "input_distribution"
              ],
              "properties": {
                "type": {
                  "const": "integer_factorization"
                },
                "modulus": {
                  "$ref": "#/$defs/text"
                },
                "size": {
                  "$ref": "#/$defs/text"
                },
                "input_distribution": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "modulus",
                "exponent",
                "input_distribution"
              ],
              "properties": {
                "type": {
                  "const": "rsa_inversion"
                },
                "modulus": {
                  "$ref": "#/$defs/text"
                },
                "exponent": {
                  "$ref": "#/$defs/text"
                },
                "input_distribution": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "group",
                "order",
                "input_distribution"
              ],
              "properties": {
                "type": {
                  "const": "discrete_logarithm"
                },
                "group": {
                  "$ref": "#/$defs/text"
                },
                "order": {
                  "$ref": "#/$defs/text"
                },
                "input_distribution": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "curve",
                "group",
                "order",
                "input_distribution"
              ],
              "properties": {
                "type": {
                  "const": "elliptic_curve_discrete_logarithm"
                },
                "curve": {
                  "$ref": "#/$defs/text"
                },
                "group": {
                  "$ref": "#/$defs/text"
                },
                "order": {
                  "$ref": "#/$defs/text"
                },
                "input_distribution": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "dimension",
                "modulus",
                "sample_count",
                "secret_distribution",
                "error_distribution"
              ],
              "properties": {
                "type": {
                  "const": "lwe"
                },
                "dimension": {
                  "$ref": "#/$defs/text"
                },
                "modulus": {
                  "$ref": "#/$defs/text"
                },
                "sample_count": {
                  "$ref": "#/$defs/text"
                },
                "secret_distribution": {
                  "$ref": "#/$defs/text"
                },
                "error_distribution": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "ring",
                "modulus",
                "sample_count",
                "secret_distribution",
