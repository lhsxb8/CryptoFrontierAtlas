{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "style_reference", "design_sources", "diagrams"],
  "properties": {
    "schema_version": {"const": 2},
    "style_reference": {"type": "object", "additionalProperties": false, "required": ["title", "author", "url", "note"], "properties": {"title": {"type": "string", "minLength": 1}, "author": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "note": {"type": "string", "minLength": 1}}},
    "design_sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "url", "locator"], "properties": {"id": {"$ref": "#/definitions/id"}, "title": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "locator": {"type": "string", "minLength": 1}}}},
    "diagrams": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "instance_ids", "specification_ids", "design_source_ids", "locator", "review", "views"],
      "properties": {
        "family_id": {"$ref": "#/definitions/id"},
        "compact_template": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.tex$"},
        "instance_ids": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"$ref": "#/definitions/id"}},
        "specification_ids": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"$ref": "#/definitions/id"}},
        "design_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
        "locator": {"type": "string", "minLength": 1},
        "review": {"type": "object", "additionalProperties": false, "required": ["status", "checked_on"], "properties": {"status": {"enum": ["source_checked", "pending"]}, "checked_on": {"type": "string", "format": "date"}}},
        "views": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "template", "label", "caption"], "properties": {
          "id": {"$ref": "#/definitions/id"}, "template": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.tex$"},
          "label": {"$ref": "#/definitions/bilingual"}, "caption": {"$ref": "#/definitions/bilingual"}
        }}}
      },
      "if": {"properties": {"review": {"type": "object", "properties": {"status": {"const": "pending"}}}}},
      "then": {"properties": {"views": {"type": "array", "maxItems": 0}, "compact_template": false}},
      "else": {"properties": {"views": {"type": "array", "minItems": 1}}}
    }}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "bilingual": {"type": "object", "additionalProperties": false, "required": ["en", "zh"], "properties": {"en": {"type": "string", "minLength": 1}, "zh": {"type": "string", "minLength": 1}}}
  }
}
